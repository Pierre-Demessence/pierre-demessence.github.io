---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { experience, education } from '../data/experience';
---

<BaseLayout title="Resume - Pierre Demessence" description="Work experience and education of Pierre Demessence.">
  <Header slot="header" />

  <section class="resume-hero">
    <div class="container">
      <h1>Resume</h1>
      <p class="resume-hero__sub">Work experience and education.</p>
    </div>
  </section>

  <section class="resume-section">
    <div class="container">
      <h2 class="section-title">Experience</h2>
      <div class="timeline">
        {experience.map((job) => (
          <article class="timeline__item">
            <div class="timeline__marker" aria-hidden="true"></div>
            <div class="timeline__content">
              <div class="timeline__header">
                <h3 class="timeline__role">{job.role}</h3>
                <span class="timeline__period">{job.period}</span>
              </div>
              <p class="timeline__company">{job.company} &middot; {job.location}</p>
              <p class="timeline__desc">{job.description}</p>
              {job.highlights.length > 0 && (
                <ul class="timeline__highlights">
                  {job.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="resume-section">
    <div class="container">
      <h2 class="section-title">Education</h2>
      <div class="timeline">
        {education.map((edu) => (
          <article class="timeline__item">
            <div class="timeline__marker" aria-hidden="true"></div>
            <div class="timeline__content">
              <div class="timeline__header">
                <h3 class="timeline__role">{edu.degree}</h3>
                <span class="timeline__period">{edu.period}</span>
              </div>
              <p class="timeline__company">{edu.school} &middot; {edu.location}</p>
              {edu.description && <p class="timeline__desc">{edu.description}</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .resume-hero {
    padding: var(--space-2xl) 0 var(--space-lg);
  }

  .resume-hero h1 {
    margin-bottom: var(--space-xs);
  }

  .resume-hero__sub {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  .resume-section {
    padding-bottom: var(--space-xl);
  }

  .section-title {
    margin-bottom: var(--space-lg);
  }

  .timeline {
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background-color: var(--color-border);
  }

  .timeline__item {
    position: relative;
    padding-bottom: var(--space-lg);
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  .timeline__marker {
    position: absolute;
    left: -2rem;
    top: 0.35rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    border: 2px solid var(--color-bg);
    z-index: 1;
  }

  .timeline__content {
    padding-left: 0.25rem;
  }

  .timeline__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: 0.25rem;
  }

  .timeline__role {
    font-size: 1.15rem;
  }

  .timeline__period {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .timeline__company {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .timeline__desc {
    margin-bottom: var(--space-xs);
  }

  .timeline__highlights {
    list-style: disc;
    padding-left: 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .timeline__highlights li {
    margin-bottom: 0.25rem;
  }

  @media (max-width: 480px) {
    .timeline__header {
      flex-direction: column;
      gap: 0.125rem;
    }
  }
</style>
