---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card">
  <div class="card__body">
    <div class="card__header">
      <h3 class="card__title">{project.title}</h3>
      <p class="card__date">{project.date}</p>
    </div>
    <p class="card__desc">{project.description}</p>
    <ul class="card__tags">
      {project.tags.map((tag) => (
        <li class="card__tag">{tag}</li>
      ))}
    </ul>
  </div>
  {(project.repo || project.live || project.article) && (
    <div class="card__links">
      {project.repo && (
        <a href={project.repo} target="_blank" rel="noopener noreferrer" class="card__link">
          Repository <span class="sr-only">(opens in new tab)</span> &rarr;
        </a>
      )}
      {project.article && (
        <a href={project.article} target="_blank" rel="noopener noreferrer" class="card__link">
          Press Archive <span class="sr-only">(opens in new tab)</span> &rarr;
        </a>
      )}
      {project.live && (
        <a href={project.live} target="_blank" rel="noopener noreferrer" class="card__link card__link--live">
          Live Demo <span class="sr-only">(opens in new tab)</span> &rarr;
        </a>
      )}
    </div>
  )}
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background-color: var(--color-bg);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 20px color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .card__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: 0.5rem;
  }

  .card__title {
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }

  .card__date {
    flex-shrink: 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.03em;
  }

  .card__desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .card__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: var(--space-sm);
  }

  .card__tag {
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background-color: var(--color-surface);
    color: var(--color-text-muted);
  }

  .card__links {
    display: flex;
    gap: var(--space-sm);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-border);
  }

  .card__link {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .card__link--live {
    color: var(--color-accent);
  }

  @media (max-width: 560px) {
    .card__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
    }
  }
</style>
